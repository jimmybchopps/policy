  4: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: MutatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: 'Sets the restricted security context where a Pod leaves it unset: runAsNonRoot true and seccomp RuntimeDefault on the pod, allowPrivilegeEscalation false and capabilities.drop [ALL] on each container and init container. A value that''s already set is never changed.'
        policy.posture.dev/nist: AC-6, CM-7
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: add-default-security-context
    spec:
      failurePolicy: Fail
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
            resources:
              - pods
      mutations:
        - jsonPatch:
            expression: |-
              (object.spec.containers.filter(c, !has(c.securityContext) ||
                  !has(c.securityContext.capabilities) || !has(c.securityContext.capabilities.drop))
                .map(c, !has(c.securityContext)
                  ? JSONPatch{op: 'add',
                      path: '/spec/containers/' + string(object.spec.containers.indexOf(c)) + '/securityContext',
                      value: Object.spec.containers.securityContext{
                        capabilities: Object.spec.containers.securityContext.capabilities{drop: ['ALL']}}}
                  : !has(c.securityContext.capabilities)
                    ? JSONPatch{op: 'add',
                        path: '/spec/containers/' + string(object.spec.containers.indexOf(c)) + '/securityContext/capabilities',
                        value: Object.spec.containers.securityContext.capabilities{drop: ['ALL']}}
                    : JSONPatch{op: 'add',
                        path: '/spec/containers/' + string(object.spec.containers.indexOf(c)) + '/securityContext/capabilities/drop',
                        value: ['ALL']})).filter(p, !variables.exempt)
          patchType: JSONPatch
        - jsonPatch:
            expression: |-
              ((has(object.spec.initContainers) ? object.spec.initContainers : [])
                .filter(c, !has(c.securityContext) ||
                  !has(c.securityContext.capabilities) || !has(c.securityContext.capabilities.drop))
                .map(c, !has(c.securityContext)
                  ? JSONPatch{op: 'add',
                      path: '/spec/initContainers/' + string(object.spec.initContainers.indexOf(c)) + '/securityContext',
                      value: Object.spec.initContainers.securityContext{
                        capabilities: Object.spec.initContainers.securityContext.capabilities{drop: ['ALL']}}}
                  : !has(c.securityContext.capabilities)
                    ? JSONPatch{op: 'add',
                        path: '/spec/initContainers/' + string(object.spec.initContainers.indexOf(c)) + '/securityContext/capabilities',
                        value: Object.spec.initContainers.securityContext.capabilities{drop: ['ALL']}}
                    : JSONPatch{op: 'add',
                        path: '/spec/initContainers/' + string(object.spec.initContainers.indexOf(c)) + '/securityContext/capabilities/drop',
                        value: ['ALL']})).filter(p, !variables.exempt)
          patchType: JSONPatch
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (!has(object.spec.securityContext) || !has(object.spec.securityContext.runAsNonRoot)
                ? Object{spec: Object.spec{securityContext: Object.spec.securityContext{runAsNonRoot: true}}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (!has(object.spec.securityContext) || !has(object.spec.securityContext.seccompProfile)
                ? Object{spec: Object.spec{securityContext: Object.spec.securityContext{
                    seccompProfile: Object.spec.securityContext.seccompProfile{type: 'RuntimeDefault'}}}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.containersWithoutEscalation) > 0
                ? Object{spec: Object.spec{containers: variables.containersWithoutEscalation.map(c,
                    Object.spec.containers{name: c.name,
                      securityContext: Object.spec.containers.securityContext{allowPrivilegeEscalation: false}})}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.initContainersWithoutEscalation) > 0
                ? Object{spec: Object.spec{initContainers: variables.initContainersWithoutEscalation.map(c,
                    Object.spec.initContainers{name: c.name,
                      securityContext: Object.spec.initContainers.securityContext{allowPrivilegeEscalation: false}})}}
                : Object{})
          patchType: ApplyConfiguration
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      reinvocationPolicy: IfNeeded
      variables:
        - expression: 'has(object.metadata.labels) ? object.metadata.labels : {}'
          name: workloadLabels
        - expression: 'has(object.spec.initContainers) ? object.spec.initContainers : []'
          name: initContainers
        - expression: |-
            object.spec.containers.filter(c,
              !has(c.securityContext) || !has(c.securityContext.allowPrivilegeEscalation))
          name: containersWithoutEscalation
        - expression: |-
            variables.initContainers.filter(c,
              !has(c.securityContext) || !has(c.securityContext.allowPrivilegeEscalation))
          name: initContainersWithoutEscalation
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'MutatingAdmissionPolicy' && e.policy.name == 'add-default-security-context' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  5: |
    apiVersion: admissionregistration.k8s.io/v1
