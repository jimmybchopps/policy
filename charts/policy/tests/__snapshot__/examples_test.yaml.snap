    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-host-namespaces
      validationActions:
        - Deny
        - Audit
  13: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-namespaces-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
