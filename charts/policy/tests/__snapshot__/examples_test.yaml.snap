          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: require-run-as-non-root
      validationActions:
        - Warn
  17: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Services may not set externalIPs.
        policy.posture.dev/nist: SC-7
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-external-ips
    spec:
      failurePolicy: Fail
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - services
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: variables.exempt || (!has(object.spec.externalIPs) || size(object.spec.externalIPs) == 0)
          message: 'spec.externalIPs must be empty or unset: it lets a Service take traffic for any address (CVE-2020-8554). If this Service needs it, add a posture exception for restrict-external-ips.'
      variables:
        - expression: 'has(object.metadata.labels) ? object.metadata.labels : {}'
          name: workloadLabels
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'restrict-external-ips' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  18: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: services
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-external-ips
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - services
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
