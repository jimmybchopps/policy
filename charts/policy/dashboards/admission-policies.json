            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum by (policy, error_type) (rate(apiserver_mutating_admission_policy_check_total{error_type!~\"|no_error\", policy=~\"__POLICIES__\"}[$__rate_interval]))",
              "legendFormat": "{{policy}} ({{error_type}})"
            }
          ]
        },
        {
          "type": "timeseries",
          "id": 16,
          "title": "Mutation latency (p99)",
          "description": "99th percentile time to evaluate each mutation.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 33
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "histogram_quantile(0.99, sum by (le, policy) (rate(apiserver_mutating_admission_policy_check_duration_seconds_bucket{policy=~\"__POLICIES__\"}[$__rate_interval])))",
              "legendFormat": "{{policy}}"
