              has(c.securityContext.capabilities.drop) &&
              'ALL' in c.securityContext.capabilities.drop))
          message: containers[*].securityContext.capabilities.drop must include ALL. If this workload needs to keep a capability, add a posture exception for require-drop-all-capabilities.
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              !has(c.securityContext) || !has(c.securityContext.capabilities) ||
