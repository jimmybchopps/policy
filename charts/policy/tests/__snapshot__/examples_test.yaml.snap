        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: variables.exempt || (variables.longRunning.all(c, has(c.readinessProbe)))
          message: containers[*].readinessProbe must be set on long-running containers (and sidecar init containers). If this workload can't have one, add a posture exception for require-probes.
        - expression: variables.exempt || (variables.longRunning.all(c, has(c.livenessProbe)))
          message: containers[*].livenessProbe must be set on long-running containers (and sidecar init containers). If this workload can't have one, add a posture exception for require-probes.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
