        policy.posture.dev/description: Only the subjects listed are bound to cluster-admin.
        policy.posture.dev/nist: AC-2, AC-6
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-cluster-admin-binding
