{
  "title": "Admission policies",
  "uid": "policy-admission",
  "description": "The policy chart's ValidatingAdmissionPolicies and MutatingAdmissionPolicies, from the API server's admission-policy metrics.",
  "tags": [
    "kubernetes",
    "admission",
    "security"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "policy",
        "label": "Policy",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(apiserver_validating_admission_policy_check_total{policy=~\"__POLICIES__\"}, policy)",
          "refId": "policy"
        },
        "definition": "label_values(apiserver_validating_admission_policy_check_total{policy=~\"__POLICIES__\"}, policy)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "type": "query",
        "name": "binding",
        "label": "Binding",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(apiserver_validating_admission_policy_check_total{policy=~\"__POLICIES__\", policy=~\"$policy\"}, policy_binding)",
          "refId": "binding"
        },
        "definition": "label_values(apiserver_validating_admission_policy_check_total{policy=~\"__POLICIES__\", policy=~\"$policy\"}, policy_binding)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Denied",
      "description": "Requests a policy refused in the time range (Pods; a Service or RBAC object at enforce).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(apiserver_validating_admission_policy_check_total{enforcement_action=~\"(?i)deny\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Warned",
      "description": "Warnings returned, mostly for controllers (Deployments, Jobs, ...): the Pods they create are what's denied.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(apiserver_validating_admission_policy_check_total{enforcement_action=~\"(?i)warn\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Audited",
      "description": "Violations recorded in the audit log (Pods, and every policy at action audit).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(apiserver_validating_admission_policy_check_total{enforcement_action=~\"(?i)audit\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Evaluation errors",
      "description": "Policy evaluations that failed rather than ran (for example a namespace without its posture-exceptions object). Policies fail closed, so these are refusals too.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(apiserver_validating_admission_policy_check_total{error_type!~\"|no_error\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "id": 6,
      "title": "By policy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Denied per policy",
      "description": "Refusals per second, per policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (policy) (rate(apiserver_validating_admission_policy_check_total{enforcement_action=~\"(?i)deny\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__rate_interval]))",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Warned per policy",
      "description": "Warnings per second, per policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (policy) (rate(apiserver_validating_admission_policy_check_total{enforcement_action=~\"(?i)warn\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__rate_interval]))",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Audited per policy",
      "description": "Audit-log violations per second, per policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (policy) (rate(apiserver_validating_admission_policy_check_total{enforcement_action=~\"(?i)audit\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__rate_interval]))",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "type": "table",
      "id": 10,
      "title": "Top policies and bindings",
      "description": "Violations in the time range by policy, binding, and action. A workload policy's Pod binding shares its name; <name>-controllers is its warning binding.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "policy": "Policy",
              "policy_binding": "Binding",
              "enforcement_action": "Action",
              "Value": "Count"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "format": "table",
          "expr": "topk(25, sum by (policy, policy_binding, enforcement_action) (increase(apiserver_validating_admission_policy_check_total{enforcement_action!=\"\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__range])) > 0)"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Evaluation errors per policy",
      "description": "Evaluations that errored, by type. Policies fail closed, so each is a refusal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (policy, error_type) (rate(apiserver_validating_admission_policy_check_total{error_type!~\"|no_error\", policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__rate_interval]))",
          "legendFormat": "{{policy}} ({{error_type}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Evaluation latency (p99)",
      "description": "99th percentile time to evaluate each policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, policy) (rate(apiserver_validating_admission_policy_check_duration_seconds_bucket{policy=~\"__POLICIES__\", policy=~\"$policy\", policy_binding=~\"$binding\"}[$__rate_interval])))",
          "legendFormat": "{{policy}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 17,
      "title": "Mutations (when mutations.enabled)",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": [
        {
          "type": "timeseries",
          "id": 14,
          "title": "Evaluated per mutation",
          "description": "Mutation evaluations per second (Pods created, outside excepted workloads and kube-system).",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 33
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum by (policy) (rate(apiserver_mutating_admission_policy_check_total{policy=~\"__POLICIES__\"}[$__rate_interval]))",
              "legendFormat": "{{policy}}"
            }
          ]
        },
        {
          "type": "timeseries",
          "id": 15,
          "title": "Mutation errors",
          "description": "Mutations that errored. Mutations fail closed, so each refused a Pod.",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 33
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
