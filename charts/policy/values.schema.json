{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Generated by make values-schema from charts/policy/definitions; don't edit by hand.",
  "properties": {
    "custom": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "inherit (take enforcement), enforce, or audit (default: inherit).",
            "enum": [
              "inherit",
              "enforce",
              "audit"
            ],
            "type": "string"
          },
          "controls": {
            "additionalProperties": false,
            "properties": {
              "nist": {
                "items": {
                  "pattern": "^[A-Z]{2}-[0-9]+",
                  "type": "string"
                },
                "type": "array"
              },
              "pss": {
                "enum": [
                  "baseline",
                  "restricted"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "enabled": {
            "description": "Whether the policy is installed (default: true).",
            "type": "boolean"
          },
          "exceptions": {
            "description": "labels (default): posture exceptions select objects by their labels (the pod template's, for workloads). none: no exceptions (rbac always; anything whose object has no labels, like pods/exec); allowlists come from the policy's settings instead.",
            "enum": [
              "labels",
              "none"
            ],
            "type": "string"
          },
          "operations": {
            "items": {
              "enum": [
                "CREATE",
                "UPDATE",
                "DELETE",
                "CONNECT"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "resources": {
            "description": "workloads | services | rbac, or a matchConstraints block (resourceRules, excludeResourceRules, matchPolicy). namespaceSelector and objectSelector aren't accepted: exclusions are the chart's decision.",
            "oneOf": [
              {
                "enum": [
                  "workloads",
                  "services",
                  "rbac"
                ],
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "excludeResourceRules": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "apiGroups": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "apiVersions": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "operations": {
                          "description": "Defaults to the policy's operations.",
                          "items": {
                            "enum": [
                              "CREATE",
                              "UPDATE",
                              "DELETE",
                              "CONNECT",
                              "*"
                            ],
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "resourceNames": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "resources": {
                          "items": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "scope": {
                          "enum": [
                            "Cluster",
                            "Namespaced",
                            "*"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "apiGroups",
                        "apiVersions",
                        "resources"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "matchPolicy": {
                    "enum": [
                      "Exact",
                      "Equivalent"
                    ],
                    "type": "string"
                  },
                  "resourceRules": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "apiGroups": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "apiVersions": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "operations": {
                          "description": "Defaults to the policy's operations.",
                          "items": {
                            "enum": [
                              "CREATE",
                              "UPDATE",
                              "DELETE",
                              "CONNECT",
                              "*"
                            ],
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "resourceNames": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "resources": {
                          "items": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "scope": {
                          "enum": [
                            "Cluster",
                            "Namespaced",
                            "*"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "apiGroups",
                        "apiVersions",
                        "resources"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "resourceRules"
                ],
                "type": "object"
              }
            ]
          },
          "validations": {
            "items": {
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "message"
                  ]
                },
                {
                  "required": [
                    "messageExpression"
                  ]
                }
              ],
              "properties": {
                "expression": {
                  "minLength": 1,
                  "type": "string"
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                },
                "messageExpression": {
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "enum": [
                    "Unauthorized",
                    "Forbidden",
                    "Invalid",
                    "RequestEntityTooLarge"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "expression"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "variables": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "expression"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "description",
          "validations"
        ],
        "type": "object"
      },
      "description": "Your own policies, in the definition format (CLAUDE.md). Names must not collide with built-in policies.",
      "propertyNames": {
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      },
      "type": "object"
    },
    "enforcement": {
      "description": "How optional and custom policies with action inherit act: enforce (deny and audit Pods) or audit (audit only). Baked-in policies always enforce.",
      "enum": [
        "enforce",
        "audit"
      ],
      "type": "string"
    },
    "global": {
      "description": "Helm's global values (set when this chart is a dependency); unused.",
      "type": "object"
    },
    "policies": {
      "additionalProperties": false,
      "description": "Each policy's settings, under its name. Baked-in policies take only their own settings; optional ones also take enabled and action.",
      "properties": {
        "disallow-host-namespaces": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Pods may not share the node's network, process, or IPC namespaces.",
          "properties": {},
          "type": "object"
        },
        "disallow-host-path": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Pods may not mount directories from the node (hostPath volumes).",
          "properties": {},
          "type": "object"
        },
        "disallow-host-ports": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Containers may not bind ports on the node (hostPort).",
          "properties": {},
          "type": "object"
        },
        "disallow-pod-exec": {
          "additionalProperties": false,
          "description": "Optional (default: off, inherit). No interactive kubectl exec or attach, except in the namespaces listed.",
          "properties": {
            "action": {
              "description": "inherit (take enforcement), enforce, or audit (default: inherit).",
              "enum": [
                "inherit",
                "enforce",
                "audit"
              ],
              "type": "string"
            },
            "enabled": {
              "description": "Whether the policy is installed (default: false).",
              "type": "boolean"
            },
            "namespaces": {
              "description": "Namespaces where kubectl exec and attach are allowed.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "disallow-privilege-escalation": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Every container sets allowPrivilegeEscalation to false.",
          "properties": {},
          "type": "object"
        },
        "disallow-privileged-containers": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Containers may not run privileged or as Windows HostProcess.",
          "properties": {},
          "type": "object"
        },
        "require-drop-all-capabilities": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Every container drops ALL capabilities and adds back nothing but NET_BIND_SERVICE.",
          "properties": {},
          "type": "object"
        },
        "require-read-only-root-filesystem": {
          "additionalProperties": false,
          "description": "Optional (default: on, inherit). Every container runs with a read-only root filesystem.",
          "properties": {
            "action": {
              "description": "inherit (take enforcement), enforce, or audit (default: inherit).",
              "enum": [
                "inherit",
                "enforce",
                "audit"
              ],
              "type": "string"
            },
            "enabled": {
              "description": "Whether the policy is installed (default: true).",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "require-run-as-non-root": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Every container runs as a non-root user.",
          "properties": {},
          "type": "object"
        },
        "restrict-apparmor": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. AppArmor, where set, uses the runtime default or a node-local profile.",
          "properties": {},
          "type": "object"
        },
        "restrict-external-ips": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Services may not set externalIPs.",
          "properties": {},
          "type": "object"
        },
        "restrict-image-registries": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes only registries. Every container image comes from one of the site's registries.",
          "properties": {
            "registries": {
              "description": "List the image prefixes this cluster may pull from, e.g. registry.site.mil/.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "restrict-proc-mount": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Containers use the default (masked) /proc mount.",
          "properties": {},
          "type": "object"
        },
        "restrict-seccomp": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Every container runs under a RuntimeDefault or Localhost seccomp profile.",
          "properties": {},
          "type": "object"
        },
        "restrict-selinux": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. SELinux options use only the container types, and never set a user or role.",
          "properties": {},
          "type": "object"
        },
        "restrict-sysctls": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Pods set only the Pod Security Standards' safe sysctls.",
          "properties": {},
          "type": "object"
        },
        "restrict-volume-types": {
          "additionalProperties": false,
          "description": "Baked-in: always on and enforced; takes no settings. Volumes are only of the Pod Security restricted types.",
          "properties": {},
          "type": "object"
        },
        "restrict-wildcard-rbac": {
          "additionalProperties": false,
          "description": "Optional (default: on, inherit). Roles and ClusterRoles don't grant \"*\" verbs, resources, or API groups.",
          "properties": {
            "action": {
              "description": "inherit (take enforcement), enforce, or audit (default: inherit).",
              "enum": [
                "inherit",
                "enforce",
                "audit"
              ],
              "type": "string"
            },
            "allowedRoles": {
              "description": "Role and ClusterRole names allowed to use \"*\".",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "enabled": {
              "description": "Whether the policy is installed (default: true).",
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "policy values",
  "type": "object"
}
