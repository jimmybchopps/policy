    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: SELinux options use only the container types, and never set a user or role.
        policy.posture.dev/nist: AC-3, SC-39
        policy.posture.dev/pss: baseline
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-selinux
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (variables.seLinuxOptions.all(o, !has(o.type) ||
              o.type in ['', 'container_t', 'container_init_t', 'container_kvm_t', 'container_engine_t']))
          message: securityContext.seLinuxOptions.type (pod and containers[*]) must be unset or one of container_t, container_init_t, container_kvm_t, container_engine_t. If this workload needs another type, add a posture exception for restrict-selinux.
        - expression: |-
            variables.exempt || (variables.seLinuxOptions.all(o,
              (!has(o.user) || o.user == '') && (!has(o.role) || o.role == '')))
          message: securityContext.seLinuxOptions.user and .role (pod and containers[*]) must be unset. If this workload needs them, add a posture exception for restrict-selinux.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: |-
            (has(variables.podSpec.securityContext) &&
              has(variables.podSpec.securityContext.seLinuxOptions)
              ? [variables.podSpec.securityContext.seLinuxOptions] : []) +
            variables.allContainers
              .filter(c, has(c.securityContext) && has(c.securityContext.seLinuxOptions))
              .map(c, c.securityContext.seLinuxOptions)
          name: seLinuxOptions
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'restrict-selinux' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
