minimal:
  1: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        helm.sh/resource-policy: keep
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: policyexceptions.policy.posture.dev
    spec:
      group: policy.posture.dev
      names:
        kind: PolicyExceptions
        listKind: PolicyExceptionsList
        plural: policyexceptions
        singular: policyexceptions
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: Per-namespace exceptions to the cluster's admission policies, read by each policy's bindings as parameters (paramRef name posture-exceptions). Rendered by posture.
              properties:
                apiVersion:
                  type: string
                kind:
                  type: string
                metadata:
                  type: object
                spec:
                  properties:
                    exceptions:
                      default: []
                      description: One entry per excepted policy, with the workloads it doesn't apply to.
                      items:
                        properties:
                          policy:
                            description: The policy excepted, by kind and name.
                            properties:
                              kind:
                                enum:
                                  - ValidatingAdmissionPolicy
                                  - MutatingAdmissionPolicy
                                type: string
                              name:
                                maxLength: 63
                                pattern: ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$
                                type: string
                            required:
                              - kind
                              - name
                            type: object
                          workloads:
                            description: Workloads in this namespace the policy doesn't apply to.
                            items:
                              properties:
                                expires:
                                  description: 'YYYY-MM-DD. Informational here: posture leaves expired entries out when it renders.'
                                  pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$
                                  type: string
                                matchLabels:
                                  additionalProperties:
                                    type: string
                                  description: 'Labels a workload''s pods carry (all must match). Never empty: an empty selector would match every workload in the namespace.'
                                  maxProperties: 16
                                  minProperties: 1
                                  type: object
                                reason:
                                  description: Why the workload needs the exception.
                                  maxLength: 1024
                                  type: string
                              required:
                                - matchLabels
                              type: object
                            maxItems: 64
                            minItems: 1
                            type: array
                        required:
                          - policy
                          - workloads
                        type: object
                      maxItems: 256
                      type: array
                  type: object
              required:
                - spec
              type: object
          served: true
          storage: true
  2: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Pods may not share the node's network, process, or IPC namespaces.
        policy.posture.dev/nist: AC-6, SC-39
        policy.posture.dev/pss: baseline
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-namespaces
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: variables.exempt || (!(has(variables.podSpec.hostNetwork) && variables.podSpec.hostNetwork))
          message: spec.hostNetwork must be false or unset. If this workload needs it, add a posture exception for disallow-host-namespaces.
        - expression: variables.exempt || (!(has(variables.podSpec.hostPID) && variables.podSpec.hostPID))
          message: spec.hostPID must be false or unset. If this workload needs it, add a posture exception for disallow-host-namespaces.
        - expression: variables.exempt || (!(has(variables.podSpec.hostIPC) && variables.podSpec.hostIPC))
          message: spec.hostIPC must be false or unset. If this workload needs it, add a posture exception for disallow-host-namespaces.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'disallow-host-namespaces' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  3: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-namespaces
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-host-namespaces
      validationActions:
        - Deny
        - Audit
  4: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-namespaces-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-host-namespaces
      validationActions:
        - Warn
  5: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Pods may not mount directories from the node (hostPath volumes).
        policy.posture.dev/nist: AC-6, SC-39
        policy.posture.dev/pss: baseline
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-path
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: variables.exempt || (!(has(variables.podSpec.volumes) && variables.podSpec.volumes.exists(v, has(v.hostPath))))
          message: spec.volumes[*].hostPath must be unset; use another volume type (emptyDir, configMap, secret, persistentVolumeClaim, ...). If this workload needs it, add a posture exception for disallow-host-path.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'disallow-host-path' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  6: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-path
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-host-path
      validationActions:
        - Deny
        - Audit
  7: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-host-path-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-host-path
      validationActions:
        - Warn
  8: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Containers may not run privileged or as Windows HostProcess.
        policy.posture.dev/nist: AC-6, CM-7
        policy.posture.dev/pss: baseline
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-privileged-containers
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (!variables.allContainers.exists(c,
              has(c.securityContext) && has(c.securityContext.privileged) && c.securityContext.privileged))
          message: containers[*].securityContext.privileged must be false or unset. If this workload needs it, add a posture exception for disallow-privileged-containers.
        - expression: |-
            variables.exempt || (!(has(variables.podSpec.securityContext) &&
              has(variables.podSpec.securityContext.windowsOptions) &&
              has(variables.podSpec.securityContext.windowsOptions.hostProcess) &&
              variables.podSpec.securityContext.windowsOptions.hostProcess) &&
            !variables.allContainers.exists(c,
              has(c.securityContext) && has(c.securityContext.windowsOptions) &&
              has(c.securityContext.windowsOptions.hostProcess) &&
              c.securityContext.windowsOptions.hostProcess))
          message: securityContext.windowsOptions.hostProcess (pod and containers[*]) must be false or unset. If this workload needs it, add a posture exception for disallow-privileged-containers.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'disallow-privileged-containers' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  9: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-privileged-containers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-privileged-containers
      validationActions:
        - Deny
        - Audit
  10: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disallow-privileged-containers-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: disallow-privileged-containers
      validationActions:
        - Warn
  11: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Every container runs with a read-only root filesystem.
        policy.posture.dev/nist: CM-7, SI-7
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: require-read-only-root-filesystem
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              has(c.securityContext) && has(c.securityContext.readOnlyRootFilesystem) &&
              c.securityContext.readOnlyRootFilesystem))
          message: containers[*].securityContext.readOnlyRootFilesystem must be true; mount an emptyDir where the container needs to write. If this workload needs a writable root filesystem, add a posture exception for require-read-only-root-filesystem.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'require-read-only-root-filesystem' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  12: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: require-read-only-root-filesystem
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: require-read-only-root-filesystem
      validationActions:
        - Deny
        - Audit
  13: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: require-read-only-root-filesystem-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: require-read-only-root-filesystem
      validationActions:
        - Warn
  14: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Every container runs as a non-root user.
        policy.posture.dev/nist: AC-6
        policy.posture.dev/pss: restricted
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: require-run-as-non-root
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              has(c.securityContext) && has(c.securityContext.runAsNonRoot)
                ? c.securityContext.runAsNonRoot
                : variables.podRunAsNonRoot))
          message: securityContext.runAsNonRoot must be true, set on the pod (spec.securityContext) or on every container, and no container may set it to false. If this workload needs it, add a posture exception for require-run-as-non-root.
        - expression: |-
            variables.exempt || (!(has(variables.podSpec.securityContext) &&
              has(variables.podSpec.securityContext.runAsUser) &&
              variables.podSpec.securityContext.runAsUser == 0) &&
            !variables.allContainers.exists(c,
              has(c.securityContext) && has(c.securityContext.runAsUser) &&
              c.securityContext.runAsUser == 0))
          message: securityContext.runAsUser (pod and containers[*]) must not be 0. If this workload needs it, add a posture exception for require-run-as-non-root.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(variables.podSpec.securityContext) && has(variables.podSpec.securityContext.runAsNonRoot) && variables.podSpec.securityContext.runAsNonRoot
          name: podRunAsNonRoot
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'require-run-as-non-root' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  15: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: require-run-as-non-root
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: require-run-as-non-root
      validationActions:
        - Deny
        - Audit
