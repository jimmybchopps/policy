minimal:
  1: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        helm.sh/resource-policy: keep
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: policyexceptions.policy.posture.dev
    spec:
      group: policy.posture.dev
      names:
        kind: PolicyExceptions
        listKind: PolicyExceptionsList
        plural: policyexceptions
        singular: policyexceptions
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: Per-namespace exceptions to the cluster's admission policies, read by each policy's bindings as parameters (paramRef name posture-exceptions). Rendered by posture.
              properties:
                apiVersion:
                  type: string
                kind:
                  type: string
                metadata:
                  type: object
                spec:
                  properties:
                    exceptions:
                      default: []
                      description: One entry per excepted policy, with the workloads it doesn't apply to.
                      items:
                        properties:
                          policy:
                            description: The policy excepted, by kind and name.
                            properties:
                              kind:
                                enum:
                                  - ValidatingAdmissionPolicy
                                  - MutatingAdmissionPolicy
                                type: string
                              name:
                                maxLength: 63
                                pattern: ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$
                                type: string
                            required:
                              - kind
                              - name
                            type: object
                          workloads:
                            description: Workloads in this namespace the policy doesn't apply to.
                            items:
                              properties:
                                expires:
                                  description: 'YYYY-MM-DD. Informational here: posture leaves expired entries out when it renders.'
                                  pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$
                                  type: string
                                matchLabels:
                                  additionalProperties:
                                    type: string
                                  description: 'Labels a workload''s pods carry (all must match). Never empty: an empty selector would match every workload in the namespace.'
                                  maxProperties: 16
                                  minProperties: 1
                                  type: object
                                reason:
                                  description: Why the workload needs the exception.
                                  maxLength: 1024
                                  type: string
                              required:
                                - matchLabels
                              type: object
                            maxItems: 64
                            minItems: 1
                            type: array
                        required:
                          - policy
                          - workloads
                        type: object
                      maxItems: 256
                      type: array
                  type: object
              required:
                - spec
              type: object
          served: true
          storage: true
  2: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Every container image comes from one of the site's registries.
        policy.posture.dev/nist: CM-7, SR-3
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-image-registries
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && request.subResource != ''ephemeralcontainers'' && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              variables.setting_registries.exists(r, c.image.startsWith(r))))
          message: containers[*].image must start with one of the registries in policies.restrict-image-registries.registries. If this workload needs another registry, add a posture exception for restrict-image-registries.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: '["registry.example.mil/","127.0.0.1:31999/"]'
          name: setting_registries
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'restrict-image-registries' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  3: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-image-registries
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-image-registries
      validationActions:
        - Deny
        - Audit
  4: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-image-registries-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-image-registries
      validationActions:
        - Warn
