              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (!has(variables.podSpec.volumes) || variables.podSpec.volumes.all(v,
              has(v.configMap) || has(v.csi) || has(v.downwardAPI) || has(v.emptyDir) ||
              has(v.ephemeral) || has(v.persistentVolumeClaim) || has(v.projected) || has(v.secret)))
          message: spec.volumes[*] must be configMap, csi, downwardAPI, emptyDir, ephemeral, persistentVolumeClaim, projected, or secret. If this workload needs another volume type, add a posture exception for restrict-volume-types.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'restrict-volume-types' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  91: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-volume-types
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-volume-types
      validationActions:
        - Deny
        - Audit
  92: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-volume-types-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-volume-types
      validationActions:
        - Warn
  93: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Roles and ClusterRoles don't grant "*" verbs, resources, or API groups.
        policy.posture.dev/nist: AC-6
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-wildcard-rbac
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!object.metadata.name.startsWith(''system:'')'
          name: not-system
      matchConstraints:
        resourceRules:
          - apiGroups:
              - rbac.authorization.k8s.io
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - roles
              - clusterroles
              - rolebindings
              - clusterrolebindings
      validations:
        - expression: variables.allowed || variables.rules.all(r, !('*' in r.verbs))
          message: 'rules[*].verbs must not contain "*": list the verbs this role needs. To allow this role, add its name to policies.restrict-wildcard-rbac.allowedRoles.'
        - expression: variables.allowed || variables.rules.all(r, !has(r.resources) || !('*' in r.resources))
          message: 'rules[*].resources must not contain "*": list the resources this role needs. To allow this role, add its name to policies.restrict-wildcard-rbac.allowedRoles.'
        - expression: variables.allowed || variables.rules.all(r, !has(r.apiGroups) || !('*' in r.apiGroups))
          message: 'rules[*].apiGroups must not contain "*": list the API groups this role needs. To allow this role, add its name to policies.restrict-wildcard-rbac.allowedRoles.'
      variables:
        - expression: '[]'
          name: setting_allowedRoles
        - expression: 'has(object.rules) ? object.rules : []'
          name: rules
        - expression: object.metadata.name in ['cluster-admin'] + variables.setting_allowedRoles
          name: allowed
  94: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: rbac
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-wildcard-rbac
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - rbac.authorization.k8s.io
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - roles
              - clusterroles
              - rolebindings
              - clusterrolebindings
      policyName: restrict-wildcard-rbac
      validationActions:
        - Deny
        - Audit
