            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-sysctls
      validationActions:
        - Warn
  89: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Volumes are only of the Pod Security restricted types.
        policy.posture.dev/nist: CM-7
        policy.posture.dev/pss: restricted
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-volume-types
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (!has(variables.podSpec.volumes) || variables.podSpec.volumes.all(v,
              has(v.configMap) || has(v.csi) || has(v.downwardAPI) || has(v.emptyDir) ||
              has(v.ephemeral) || has(v.persistentVolumeClaim) || has(v.projected) || has(v.secret)))
          message: spec.volumes[*] must be configMap, csi, downwardAPI, emptyDir, ephemeral, persistentVolumeClaim, projected, or secret. If this workload needs another volume type, add a posture exception for restrict-volume-types.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'restrict-volume-types' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  90: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-volume-types
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-volume-types
      validationActions:
        - Deny
        - Audit
  91: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: controllers
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-volume-types-controllers
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramRef:
        name: posture-exceptions
        parameterNotFoundAction: Deny
      policyName: restrict-volume-types
      validationActions:
        - Warn
  92: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Roles and ClusterRoles don't grant "*" verbs, resources, or API groups.
        policy.posture.dev/nist: AC-6
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-wildcard-rbac
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!object.metadata.name.startsWith(''system:'')'
          name: not-system
      matchConstraints:
        resourceRules:
          - apiGroups:
              - rbac.authorization.k8s.io
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - roles
              - clusterroles
              - rolebindings
              - clusterrolebindings
      validations:
        - expression: variables.allowed || variables.rules.all(r, !('*' in r.verbs))
          message: 'rules[*].verbs must not contain "*": list the verbs this role needs. To allow this role, add its name to policies.restrict-wildcard-rbac.allowedRoles.'
        - expression: variables.allowed || variables.rules.all(r, !has(r.resources) || !('*' in r.resources))
          message: 'rules[*].resources must not contain "*": list the resources this role needs. To allow this role, add its name to policies.restrict-wildcard-rbac.allowedRoles.'
        - expression: variables.allowed || variables.rules.all(r, !has(r.apiGroups) || !('*' in r.apiGroups))
          message: 'rules[*].apiGroups must not contain "*": list the API groups this role needs. To allow this role, add its name to policies.restrict-wildcard-rbac.allowedRoles.'
      variables:
        - expression: '[]'
          name: setting_allowedRoles
        - expression: 'has(object.rules) ? object.rules : []'
          name: rules
        - expression: object.metadata.name in ['cluster-admin'] + variables.setting_allowedRoles
          name: allowed
  93: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: rbac
        policy.posture.dev/tier: optional
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: restrict-wildcard-rbac
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
        resourceRules:
          - apiGroups:
              - rbac.authorization.k8s.io
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - roles
              - clusterroles
              - rolebindings
              - clusterrolebindings
      policyName: restrict-wildcard-rbac
      validationActions:
        - Deny
        - Audit
mutations:
  1: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        helm.sh/resource-policy: keep
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: policyexceptions.policy.posture.dev
    spec:
      group: policy.posture.dev
      names:
        kind: PolicyExceptions
        listKind: PolicyExceptionsList
        plural: policyexceptions
        singular: policyexceptions
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: Per-namespace exceptions to the cluster's admission policies, read by each policy's bindings as parameters (paramRef name posture-exceptions). Rendered by posture.
              properties:
                apiVersion:
                  type: string
                kind:
                  type: string
                metadata:
                  type: object
                spec:
                  properties:
                    exceptions:
                      default: []
                      description: One entry per excepted policy, with the workloads it doesn't apply to.
                      items:
                        properties:
                          policy:
                            description: The policy excepted, by kind and name.
                            properties:
                              kind:
                                enum:
                                  - ValidatingAdmissionPolicy
                                  - MutatingAdmissionPolicy
                                type: string
                              name:
                                maxLength: 63
                                pattern: ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$
                                type: string
                            required:
                              - kind
                              - name
                            type: object
                          workloads:
                            description: Workloads in this namespace the policy doesn't apply to.
                            items:
                              properties:
                                expires:
                                  description: 'YYYY-MM-DD. Informational here: posture leaves expired entries out when it renders.'
                                  pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$
                                  type: string
                                matchLabels:
                                  additionalProperties:
                                    type: string
                                  description: 'Labels a workload''s pods carry (all must match). Never empty: an empty selector would match every workload in the namespace.'
                                  maxProperties: 16
                                  minProperties: 1
                                  type: object
                                reason:
                                  description: Why the workload needs the exception.
                                  maxLength: 1024
                                  type: string
                              required:
                                - matchLabels
                              type: object
                            maxItems: 64
                            minItems: 1
                            type: array
                        required:
                          - policy
                          - workloads
                        type: object
                      maxItems: 256
                      type: array
                  type: object
              required:
                - spec
              type: object
          served: true
          storage: true
  2: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: MutatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Sets a CPU request, a memory request, and a memory limit on each container and init container that leaves them unset, from this mutation's settings. A memory limit is never set below the container's memory request. Values that are already set are never changed.
        policy.posture.dev/nist: SC-5
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: add-default-resources
    spec:
      failurePolicy: Fail
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
            resources:
              - pods
      mutations:
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.containersWithoutCpuRequest) > 0
                ? Object{spec: Object.spec{containers: variables.containersWithoutCpuRequest.map(c,
                    Object.spec.containers{name: c.name, resources: Object.spec.containers.resources{
                      requests: {'cpu': variables.setting_cpuRequest}}})}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.initContainersWithoutCpuRequest) > 0
                ? Object{spec: Object.spec{initContainers: variables.initContainersWithoutCpuRequest.map(c,
                    Object.spec.initContainers{name: c.name, resources: Object.spec.initContainers.resources{
                      requests: {'cpu': variables.setting_cpuRequest}}})}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.containersWithoutMemoryRequest) > 0
                ? Object{spec: Object.spec{containers: variables.containersWithoutMemoryRequest.map(c,
                    Object.spec.containers{name: c.name, resources: Object.spec.containers.resources{
                      requests: {'memory': variables.setting_memoryRequest}}})}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.initContainersWithoutMemoryRequest) > 0
                ? Object{spec: Object.spec{initContainers: variables.initContainersWithoutMemoryRequest.map(c,
                    Object.spec.initContainers{name: c.name, resources: Object.spec.initContainers.resources{
                      requests: {'memory': variables.setting_memoryRequest}}})}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.containersWithoutMemoryLimit) > 0
                ? Object{spec: Object.spec{containers: variables.containersWithoutMemoryLimit.map(c,
                    Object.spec.containers{name: c.name, resources: Object.spec.containers.resources{
                      limits: {'memory': has(c.resources) && has(c.resources.requests) && 'memory' in c.resources.requests &&
                        quantity(string(c.resources.requests['memory'])).isGreaterThan(quantity(variables.defaultMemoryLimit))
                        ? string(c.resources.requests['memory']) : variables.defaultMemoryLimit}}})}}
                : Object{})
          patchType: ApplyConfiguration
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (size(variables.initContainersWithoutMemoryLimit) > 0
                ? Object{spec: Object.spec{initContainers: variables.initContainersWithoutMemoryLimit.map(c,
                    Object.spec.initContainers{name: c.name, resources: Object.spec.initContainers.resources{
                      limits: {'memory': has(c.resources) && has(c.resources.requests) && 'memory' in c.resources.requests &&
                        quantity(string(c.resources.requests['memory'])).isGreaterThan(quantity(variables.defaultMemoryLimit))
                        ? string(c.resources.requests['memory']) : variables.defaultMemoryLimit}}})}}
                : Object{})
          patchType: ApplyConfiguration
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      reinvocationPolicy: IfNeeded
      variables:
        - expression: 'has(object.metadata.labels) ? object.metadata.labels : {}'
          name: workloadLabels
        - expression: '"100m"'
          name: setting_cpuRequest
        - expression: '"128Mi"'
          name: setting_memoryLimit
        - expression: '"128Mi"'
          name: setting_memoryRequest
        - expression: 'has(object.spec.initContainers) ? object.spec.initContainers : []'
          name: initContainers
        - expression: |-
            quantity(variables.setting_memoryLimit).isLessThan(quantity(variables.setting_memoryRequest))
              ? variables.setting_memoryRequest : variables.setting_memoryLimit
          name: defaultMemoryLimit
        - expression: |-
            object.spec.containers.filter(c, !has(c.resources) || !has(c.resources.requests) ||
              !('cpu' in c.resources.requests))
          name: containersWithoutCpuRequest
        - expression: |-
            variables.initContainers.filter(c, !has(c.resources) || !has(c.resources.requests) ||
              !('cpu' in c.resources.requests))
          name: initContainersWithoutCpuRequest
        - expression: |-
            object.spec.containers.filter(c, !has(c.resources) || !has(c.resources.requests) ||
              !('memory' in c.resources.requests))
          name: containersWithoutMemoryRequest
        - expression: |-
            variables.initContainers.filter(c, !has(c.resources) || !has(c.resources.requests) ||
              !('memory' in c.resources.requests))
          name: initContainersWithoutMemoryRequest
        - expression: |-
            object.spec.containers.filter(c, !has(c.resources) || !has(c.resources.limits) ||
              !('memory' in c.resources.limits))
          name: containersWithoutMemoryLimit
        - expression: |-
            variables.initContainers.filter(c, !has(c.resources) || !has(c.resources.limits) ||
              !('memory' in c.resources.limits))
          name: initContainersWithoutMemoryLimit
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'MutatingAdmissionPolicy' && e.policy.name == 'add-default-resources' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
