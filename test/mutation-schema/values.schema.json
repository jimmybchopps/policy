{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mutation definition",
  "description": "A mutation definition (charts/policy/definitions/mutating/<name>.yaml): one MutatingAdmissionPolicy on Pods (CREATE), off unless mutations.enabled. Mutations never overwrite a set value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "default",
    "description",
    "mutations"
  ],
  "properties": {
    "name": {
      "description": "The policy's name, a contract with posture exceptions; matches the file name.",
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "default": {
      "description": "Whether the mutation is on when mutations.enabled is true (mutations.policies.<name>.enabled overrides it).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "description": {
      "description": "What the mutation sets, and that it only sets unset fields.",
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pss": {
          "type": "string",
          "enum": [
            "baseline",
            "restricted"
          ]
        },
        "nist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}-[0-9]+"
          }
        }
      }
    },
    "settings": {
      "description": "Settings the policy accepts under mutations.policies.<name>; read as variables.setting_<name>.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "list",
              "string",
              "bool"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "description": "What to set; shown when a required setting is missing.",
            "type": "string",
            "minLength": 1
          },
          "default": {},
          "items": {
            "description": "For list settings: a JSON schema for each item, used in the values schema (default: a non-empty string).",
            "type": "object"
          },
          "pattern": {
            "description": "For string settings: a regular expression the value must match, used in the values schema.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "expression"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "expression": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mutations": {
      "description": "Applied in order; each sees the result of the ones before it. The renderer makes every mutation a no-op for an excepted Pod.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patchType",
          "expression"
        ],
        "properties": {
          "patchType": {
            "type": "string",
            "enum": [
              "ApplyConfiguration",
              "JSONPatch"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
