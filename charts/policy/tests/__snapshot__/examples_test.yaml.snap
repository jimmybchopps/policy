    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Every container drops ALL capabilities and adds back nothing but NET_BIND_SERVICE.
        policy.posture.dev/nist: AC-6, CM-7
        policy.posture.dev/pss: restricted
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: require-drop-all-capabilities
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: '!(request.operation == ''UPDATE'' && object.kind == ''Pod'' && !(has(request.subResource) && request.subResource == ''ephemeralcontainers'') && object.spec == oldObject.spec)'
          name: pod-spec-changed
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
              - pods/ephemeralcontainers
          - apiGroups:
              - apps
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - deployments
              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              has(c.securityContext) && has(c.securityContext.capabilities) &&
              has(c.securityContext.capabilities.drop) &&
              'ALL' in c.securityContext.capabilities.drop))
          message: containers[*].securityContext.capabilities.drop must include ALL. If this workload needs to keep a capability, add a posture exception for require-drop-all-capabilities.
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              !has(c.securityContext) || !has(c.securityContext.capabilities) ||
              !has(c.securityContext.capabilities.add) ||
              c.securityContext.capabilities.add.all(a, a == 'NET_BIND_SERVICE')))
          message: containers[*].securityContext.capabilities.add may contain only NET_BIND_SERVICE. If this workload needs another capability, add a posture exception for require-drop-all-capabilities.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
