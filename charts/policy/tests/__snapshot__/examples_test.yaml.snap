              : m.key in variables.annotations && variables.annotations[m.key] == m.value))
          message: The pod (or pod template) carries a label or annotation in policies.disallow-mesh-opt-out.markers, which takes it out of the service mesh. Remove it; if this workload must run outside the mesh, add a posture exception for disallow-mesh-opt-out.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
