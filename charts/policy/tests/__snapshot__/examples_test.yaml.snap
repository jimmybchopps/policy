            (has(variables.podSpec.initContainers)
              ? variables.podSpec.initContainers.filter(c,
                  has(c.restartPolicy) && c.restartPolicy == 'Always')
              : [])
          name: longRunning
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'require-probes' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
