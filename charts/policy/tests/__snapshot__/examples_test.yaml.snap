  6: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: MutatingAdmissionPolicy
    metadata:
      annotations:
        policy.posture.dev/description: Sets automountServiceAccountToken false where a Pod leaves it unset, and removes the token volume (kube-api-access-*) and its mounts that the ServiceAccount admission plugin already added. A Pod that sets automountServiceAccountToken true keeps its token.
        policy.posture.dev/nist: AC-6
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
      name: disable-service-account-token-automount
    spec:
      failurePolicy: Fail
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
            resources:
              - pods
      mutations:
        - jsonPatch:
            expression: |-
              (size(variables.tokenVolumes) == 0 ? [] : object.spec.containers
                .filter(c, has(c.volumeMounts) && c.volumeMounts.exists(m, m.name == variables.tokenVolumes[0].name))
                .map(c, JSONPatch{op: 'remove', path: '/spec/containers/' + string(object.spec.containers.indexOf(c)) +
                  '/volumeMounts/' + string(c.volumeMounts.indexOf(
                    c.volumeMounts.filter(m, m.name == variables.tokenVolumes[0].name)[0]))}) +
              variables.initContainers
                .filter(c, has(c.volumeMounts) && c.volumeMounts.exists(m, m.name == variables.tokenVolumes[0].name))
                .map(c, JSONPatch{op: 'remove', path: '/spec/initContainers/' + string(variables.initContainers.indexOf(c)) +
                  '/volumeMounts/' + string(c.volumeMounts.indexOf(
                    c.volumeMounts.filter(m, m.name == variables.tokenVolumes[0].name)[0]))}) +
              [JSONPatch{op: 'remove', path: '/spec/volumes/' + string(object.spec.volumes.indexOf(variables.tokenVolumes[0]))}]).filter(p, !variables.exempt)
          patchType: JSONPatch
        - applyConfiguration:
            expression: |-
              variables.exempt ? Object{} : (!has(object.spec.automountServiceAccountToken)
                ? Object{spec: Object.spec{automountServiceAccountToken: false}}
                : Object{})
          patchType: ApplyConfiguration
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      reinvocationPolicy: IfNeeded
      variables:
        - expression: 'has(object.metadata.labels) ? object.metadata.labels : {}'
          name: workloadLabels
        - expression: |-
            (!has(object.spec.automountServiceAccountToken) || !object.spec.automountServiceAccountToken) && has(object.spec.volumes)
              ? object.spec.volumes.filter(v, v.name.startsWith('kube-api-access-') && has(v.projected))
              : []
          name: tokenVolumes
