              - rbac.authorization.k8s.io
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - roles
              - clusterroles
              - rolebindings
              - clusterrolebindings
      validations:
        - expression: |-
            !variables.bindsClusterAdmin || variables.subjects.all(s, variables.allowedSubjects.exists(a,
              a.kind == s.kind && a.name == s.name &&
              (s.kind != 'ServiceAccount' || ('namespace' in a && a.namespace == s.namespace))))
          message: Only the subjects in policies.restrict-cluster-admin-binding.allowedSubjects may be bound to cluster-admin; bind a narrower role instead. To allow a subject, add it there ({kind, name}, plus namespace for a ServiceAccount).
      variables:
        - expression: '[]'
          name: setting_allowedSubjects
        - expression: has(object.roleRef) && object.roleRef.kind == 'ClusterRole' && object.roleRef.name == 'cluster-admin'
          name: bindsClusterAdmin
        - expression: '[{''kind'': ''Group'', ''name'': ''system:masters''}] + variables.setting_allowedSubjects'
          name: allowedSubjects
        - expression: 'has(object.subjects) ? object.subjects : []'
          name: subjects
