              - statefulsets
              - daemonsets
              - replicasets
          - apiGroups:
              - batch
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - jobs
              - cronjobs
      paramKind:
        apiVersion: policy.posture.dev/v1alpha1
        kind: PolicyExceptions
      validations:
        - expression: variables.exempt || (!(has(variables.podSpec.hostNetwork) && variables.podSpec.hostNetwork))
          message: spec.hostNetwork must be false or unset. If this workload needs it, add a posture exception for disallow-host-namespaces.
        - expression: variables.exempt || (!(has(variables.podSpec.hostPID) && variables.podSpec.hostPID))
          message: spec.hostPID must be false or unset. If this workload needs it, add a posture exception for disallow-host-namespaces.
        - expression: variables.exempt || (!(has(variables.podSpec.hostIPC) && variables.podSpec.hostIPC))
          message: spec.hostIPC must be false or unset. If this workload needs it, add a posture exception for disallow-host-namespaces.
      variables:
        - expression: 'object.kind == ''Pod'' ? object.spec : (object.kind == ''CronJob'' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)'
          name: podSpec
        - expression: 'object.kind == ''Pod'' ? dyn(object.metadata) : (object.kind == ''CronJob'' ? (has(object.spec.jobTemplate.spec.template.metadata) ? dyn(object.spec.jobTemplate.spec.template.metadata) : dyn({})) : (has(object.spec.template.metadata) ? dyn(object.spec.template.metadata) : dyn({})))'
          name: podMeta
        - expression: 'has(variables.podMeta.labels) ? variables.podMeta.labels : {}'
          name: workloadLabels
        - expression: 'variables.podSpec.containers + (has(variables.podSpec.initContainers) ? variables.podSpec.initContainers : []) + dyn(has(variables.podSpec.ephemeralContainers) ? variables.podSpec.ephemeralContainers : [])'
          name: allContainers
        - expression: has(params.spec) && has(params.spec.exceptions) && params.spec.exceptions.exists(e, e.policy.kind == 'ValidatingAdmissionPolicy' && e.policy.name == 'disallow-host-namespaces' && has(e.workloads) && e.workloads.exists(w, has(w.matchLabels) && size(w.matchLabels) > 0 && w.matchLabels.all(k, k in variables.workloadLabels && variables.workloadLabels[k] == w.matchLabels[k])))
          name: exempt
  12: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      annotations:
        policy.posture.dev/binding: pods
        policy.posture.dev/tier: baked-in
      labels:
        app.kubernetes.io/instance: policy
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: policy
        helm.sh/chart: policy-0.1.0
