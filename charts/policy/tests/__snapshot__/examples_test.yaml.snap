      validations:
        - expression: |-
            variables.exempt || (variables.allContainers.all(c,
              has(c.securityContext) && has(c.securityContext.seccompProfile)
                ? c.securityContext.seccompProfile.type in ['RuntimeDefault', 'Localhost']
                : variables.podSeccompAllowed))
          message: securityContext.seccompProfile.type must be RuntimeDefault or Localhost, set on the pod (spec.securityContext) or on every container, and no container may set Unconfined. If this workload needs it, add a posture exception for restrict-seccomp.
